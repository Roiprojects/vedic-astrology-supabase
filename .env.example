# Supabase configuration (PostgreSQL NOT used directly in this variant)
# Create a Supabase project at https://supabase.com and copy values here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is optional — only needed for server-side admin operations.
# SUPABASE_ANON_KEY is sufficient for server reads/writes via PostgREST.
# DATABASE_URL is required for migrations — copy from Supabase project Settings → Database → Connection String.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Public Vite client configuration
VITE_SITE_URL=
VITE_WHATSAPP_NUMBER=
VITE_API_BASE_URL=

# Razorpay payment gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# Server-only configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FRONTEND_URL=https://myvedicastrology.in

# Email notifications
SMTP_HOST=webmail.myvedicastrology.in
SMTP_PORT=465
SMTP_USER=info@myvedicastrology.in
SMTP_PASS=
SMTP_FROM=info@myvedicastrology.in
SMTP_REPLY_TO=info@myvedicastrology.in
SMTP_ENVELOPE_FROM=info@myvedicastrology.in
SMTP_TLS_SERVERNAME=webmail.myvedicastrology.in
ADMIN_EMAIL=

# Admin authentication — REQUIRED, no defaults (all must be set in production)
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay subscription webhook — REQUIRED for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=

# Gmail SMTP (alternate to standard SMTP)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Build identifier (exposed in /api/health)
BUILD_ID=
