{
  "name": "vedic-astrology-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --import=tsx/esm --watch server/index.ts",
    "start": "node --import=tsx/esm server/index.ts",
    "build:all": "npm run build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "apk:debug": "npm run cap:sync && node scripts/android-apk.mjs debug",
    "apk:release": "npm run cap:sync && node scripts/android-apk.mjs release",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "migrate": "node server/migrations/run.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "dev:vite": "vite",
    "dev:api": "node --import=tsx/esm server/index.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
    "@supabase/supabase-js": "^2.49.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "framer-motion": "^12.43.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^6.30.0",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/node": "^13.0.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
